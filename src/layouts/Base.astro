---
import { SITE_NAME, TOOLS } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: object;
  /** 도구 페이지면 slug. 하단에 다른 도구 링크를 붙입니다. */
  toolSlug?: string;
}

const { title, description, jsonLd, toolSlug } = Astro.props;
// 아래 값들은 Vercel 환경변수로 넣습니다. 비어 있으면 태그를 넣지 않습니다.
const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID;
const googleVerify = import.meta.env.PUBLIC_GOOGLE_VERIFY;
const naverVerify = import.meta.env.PUBLIC_NAVER_VERIFY;
const others = toolSlug ? TOOLS.filter((t) => t.slug !== toolSlug) : [];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {googleVerify && <meta name="google-site-verification" content={googleVerify} />}
    {naverVerify && <meta name="naver-site-verification" content={naverVerify} />}
    {adsenseId && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`} crossorigin="anonymous"></script>}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="site">
    <header class="site-header">
      <a class="site-logo" href="/">{SITE_NAME}</a>
    </header>
    <main>
      <slot />
      {others.length > 0 && (
        <nav class="page related" aria-label="다른 도구">
          <h2>다른 생활 도구</h2>
          <ul class="tool-list">
            {others.map((t) => (
              <li><a href={`/${t.slug}/`}><strong>{t.name}</strong><span>{t.summary}</span></a></li>
            ))}
          </ul>
        </nav>
      )}
    </main>
    <footer class="site-footer">
      <nav class="site-footer__tools" aria-label="도구 목록">
        {TOOLS.map((t) => <a href={`/${t.slug}/`}>{t.name}</a>)}
      </nav>
      <nav class="site-footer__links" aria-label="사이트 정보">
        <a href="/about/">사이트 소개</a>
        <a href="/privacy/">개인정보처리방침</a>
        <a href="/contact/">문의</a>
      </nav>
      <p class="site-footer__copy">© {new Date().getFullYear()} {SITE_NAME}</p>
    </footer>
  </body>
</html>

<style is:global>
  .site {
    margin: 0;
    background: #e8ebee;
    color: #14161a;
    font-family: 'Pretendard Variable', -apple-system, BlinkMacSystemFont,
      'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  .site main,
  .site-header,
  .site-footer {
    max-width: 480px;
    margin: 0 auto;
    background: #fff;
  }
  .site-header {
    padding: 14px 20px;
    border-bottom: 1px solid #e7eaee;
  }
  .site-logo {
    color: #14161a;
    font-weight: 800;
    font-size: 17px;
    text-decoration: none;
  }
  .site-footer {
    padding: 28px 20px 40px;
    border-top: 1px solid #e7eaee;
    font-size: 13px;
    color: #555b64;
  }
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-bottom: 14px;
  }
  .site-footer a { color: #555b64; }
  .site-footer__copy { margin: 0; color: #939aa3; }

  .page { padding: 22px 20px 32px; }
  .page h1 { margin: 0 0 8px; font-size: 24px; font-weight: 800; letter-spacing: -0.04em; line-height: 1.35; }
  .page h2 { margin: 30px 0 12px; font-size: 19px; font-weight: 800; color: #14161a; }
  .page h3 { margin: 18px 0 6px; font-size: 16px; font-weight: 700; }
  .page p, .page li { color: #2f343b; }
  .page .intro { color: #555b64; margin: 0 0 4px; }
  .page table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 8px 0; }
  .page th, .page td { border-bottom: 1px solid #e7eaee; padding: 8px 6px; text-align: left; vertical-align: top; }
  .page th { color: #555b64; font-weight: 600; }
  .page .muted { color: #939aa3; font-size: 13px; }

  .tool-shell { border-top: 1px solid #e7eaee; border-bottom: 1px solid #e7eaee; }
  .tool-shell h2.tool-h:not(.q) { margin: 0 0 6px; font-size: 22px; font-weight: 800; letter-spacing: -0.04em; color: #14161a; }

  .faq dt { font-weight: 700; margin-top: 14px; }
  .faq dd { margin: 4px 0 0; color: #2f343b; }

  .related { border-top: 1px solid #e7eaee; }
  .tool-list { list-style: none; padding: 0; margin: 16px 0 0; }
  .tool-list li { border-bottom: 1px solid #e7eaee; }
  .tool-list a { display: block; padding: 14px 0; color: inherit; text-decoration: none; }
  .tool-list strong { display: block; font-size: 16px; }
  .tool-list span { color: #555b64; font-size: 14px; }
</style>
